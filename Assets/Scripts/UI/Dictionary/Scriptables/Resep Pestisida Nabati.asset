  m_Name: Resep Pestisida Nabati
  m_EditorClassIdentifier: Assembly-CSharp::MechanicEntry
  mechanicName: Resep Pesisida Nabati
  mechanicDescription: Pestisida nabati bawang putih dan cabai adalah pembasmi hama
    alami yang sangat ampuh mengusir kutu dan ulat. Senyawa allicin pada bawang putih
    dan capsaicin pada cabai bekerja sebagai penolak hama dan insektisida kontak.
    Untuk membuat pestisida nabati, letakkan "Bawang Putih" dan "Cabai" pada mesin
    pembuat, lalu klik tombol "ON" pada bagian bawah
  mechanicImage: {fileID: 21300000, guid: 3d600a560d298d141a2dfedad2d33444, type: 3}
