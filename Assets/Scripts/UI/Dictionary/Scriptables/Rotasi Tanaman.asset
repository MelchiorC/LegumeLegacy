  m_Name: Rotasi Tanaman
  m_EditorClassIdentifier: Assembly-CSharp::MechanicEntry
  mechanicName: Rotasi Tanaman
  mechanicDescription: Rotasi tanaman adalah praktik menanam jenis tanaman berbeda
    secara bergantian di lahan yang sama pada periode tertentu. Teknik ini krusial
    untuk memutus siklus hama dan penyakit. Untuk melakukan rotasi tanaman, tanamlah
    tanaman yang berbeda pada satu petak tanah. Disarankan untuk menanam tanaman
    "puera" terlebih dahulu sebelum menanam tanaman penghasil agar hasil maksimal
  mechanicImage: {fileID: 21300000, guid: 76369a98cb076fa42a8f4e888f6d2d38, type: 3}
